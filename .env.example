# ── Required ────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here

# ── Authorization ───────────────────────────────────────
# Single user mode (boop-telegram compatible)
AUTHORIZED_USER_ID=your_telegram_user_id
# Multi-user mode (comma-separated, telegram-agent compatible)
AUTHORIZED_USER_IDS=
AUTHORIZED_CHAT_IDS=

# ── LLM Provider (choose one) ───────────────────────────
# Options: "anthropic" | "openai"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI / OpenRouter
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ── Convex (optional — omit for in-memory mode) ─────────
CONVEX_URL=https://your-project.convex.cloud
# Admin key for Convex HTTP calls (used by the bot's Convex client)
# CONVEX_ADMIN_KEY=

# ── System / Persona ───────────────────────────────────
# Optional default system prompt (overrides the built-in persona).
# Can also be changed at runtime per chat with /system set <prompt>.
# SYSTEM_PROMPT=You are a helpful assistant.
# Optional message sent to unauthorized users.
# UNAUTHORIZED_MESSAGE=You are not authorized to use this bot.

# ── Web Search ──────────────────────────────────────────
# Tavily (preferred) — omit to use DuckDuckGo fallback
TAVILY_API_KEY=tvly-...
# TalorData SERP API (alternative — set WEB_SEARCH_PROVIDER=talordata to use)
TALORDATA_API_KEY=sk-...
# Provider selection: "tavily" | "talordata" | "scrape" (default: "scrape")
# WEB_SEARCH_PROVIDER=talordata

# ── Bot Mode ────────────────────────────────────────────
# Only polling is supported (webhook stub not shipped)
BOT_MODE=polling
# WEB_FETCH_HEADERS — optional extra headers for private/login-gated links
# JSON: {"example.com": {"Authorization": "Bearer ..."}, "other.com": {"Cookie": "..."}}
# WEB_FETCH_HEADERS={"github.com": {"Authorization": "Bearer ghp_..."}}

# ── Logging ─────────────────────────────────────────────
LOG_LEVEL=info

# ── Digest (telegram-summarizer port — all optional) ────
# With MTProto (TELEGRAM_API_ID/HASH + SESSION_B64) the bot reads full
# dialogs. Without it, digest falls back to Bot-API (chats the bot saw).
# TELEGRAM_API_ID=123456
# TELEGRAM_API_HASH=your_api_hash
# SESSION_B64=base64-encoded GramJS StringSession (from Telethon/GramJS login)
# TELEGRAM_PHONE=+12125551234
# TELEGRAM_SESSION_NAME=tg_session
# TIMEZONE=Africa/Accra
# DEFAULT_HOURS=24
# AUTO_DIGEST_HOUR=8
# MAX_CHATS=25
# MAX_MESSAGES=800
# CHUNK_CHARS=15000
# MAX_MSG_CHARS=280

# ── folk engine (proactive accountability — better than folk.com) ──
# Morning briefing hour in TIMEZONE (0-23, default 7). Wind-down off unless set.
# BRIEFING_HOUR=7
# WIND_DOWN_HOUR=22
# Minutes before an unanswered check-in gets a follow-up nudge.
# FOLLOWUP_MINUTES=120
# Local JSON persistence for habits + memory graph (works without Convex).
# FOLK_DB_PATH=folk.db.json
# Public base URL so /boop can open the Telegram WebApp dashboard.
# PUBLIC_URL=https://your-service.onrender.com

# ── Overnight Trading (paper simulator — no keys required) ───────────
# Free: Yahoo Finance (no key) + optional FINNHUB_API_KEY (free tier https://finnhub.io) fallback.
# Simulated broker persists to paper-broker.json; equity via PAPER_EQUITY. No Tradier/Alpaca needed.
# FINNHUB_API_KEY=your_finnhub_key_optional
# PAPER_EQUITY=100000
# SYMBOLS=SPY,QQQ,AAPL
# EQUITY_PER_TRADE_PCT=10
# MAX_TOTAL_EXPOSURE_PCT=50
# MAX_POSITIONS=5
# DRY_RUN=true
# DB_PATH=bot.db.json
# ENTRY_MAX_MINUTES_TO_CLOSE=30
# EXIT_MIN_MINUTES_TO_OPEN=10
# EXIT_MAX_MINUTES_TO_OPEN=4320
